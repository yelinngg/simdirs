---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, pick, formatDate, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getSim, getAllSims } from '../lib/queries';
import { leadClause } from '../lib/format';
import { marked } from 'marked';

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const tr = t(lang);
const sim = await getSim(slug);

// Slugs come from getStaticPaths, so a miss means content and route disagree —
// fail the build instead of silently serving an empty page.
if (!sim) throw new Error(`No SIM entry for slug "${slug}"`);

const d = sim.data;
const name = pick(d.name, lang);
const description = pick(d.description, lang);
const features = pick(d.features, lang);
const bestFor = d.bestFor ? pick(d.bestFor, lang) : undefined;
const details = d.details ? pick(d.details, lang) : undefined;
const pros = d.pros ? pick(d.pros, lang) : undefined;
const cons = d.cons ? pick(d.cons, lang) : undefined;
const plansNote = d.plansNote ? pick(d.plansNote, lang) : undefined;
const path = `/sims/${slug}`;

// Related providers: same region first, then same device type, then rating — capped at 6.
const allSims = await getAllSims();
const related = allSims
  .filter((s) => s.id !== slug)
  .map((s) => {
    const overlap = s.data.regions.filter((r) => d.regions.includes(r)).length;
    return { s, score: overlap * 2 + (s.data.device === d.device ? 1 : 0) + s.data.rating / 10 };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 6)
  .map((x) => x.s);

// Render details as Markdown per Astro's official pattern (marked + set:html).
// Content comes from our own curated JSON (not user input), so raw HTML is safe here.
const mdDescription = marked.parse(description, { async: false }) as string;
const mdDetails = details
  ? (marked.parse(details, { async: false }) as string)
  : undefined;

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  brand: { '@type': 'Brand', name },
  // price 0 would emit an invalid Offer, so free-tier entries carry no offers.
  ...(d.plansFrom > 0
    ? {
        offers: {
          '@type': 'Offer',
          price: d.plansFrom,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: new URL(localePath(lang, path), Astro.site).href,
        },
      }
    : {}),
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: d.rating,
      bestRating: 5,
      worstRating: 0,
    },
    author: { '@type': 'Organization', name: tr.site.name },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tr.site.name, item: new URL(localePath(lang, '/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: tr.sim.breadcrumbList, item: new URL(localePath(lang, '/sims'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name },
  ],
};

// 18 of 40 listings are single-country cards (UK, HK, Croatia, Estonia…).
// "1+ countries & regions" is technically true and reads like a template bug,
// so those get a plain label instead of a "+" that means nothing.
const coverageLabel =
  d.coverage <= 1 ? tr.sim.singleCountry : `${d.coverage}+ ${tr.sim.countries}`;

const specs = [
  { label: tr.sim.from, value: d.plansFrom > 0 ? `$${d.plansFrom.toFixed(2)} USD` : tr.sim.free },
  { label: tr.sim.dataFrom, value: pick(d.dataFrom, lang) },
  { label: tr.sim.validity, value: pick(d.validity, lang) },
  { label: tr.sim.network, value: pick(d.network, lang) },
  { label: tr.sim.hotspot, value: d.hotspot ? tr.sim.yes : tr.sim.no },
  { label: tr.sim.coverage, value: coverageLabel },
];

// IP exit profile block (country + nature + confidence-sourced note)
const ip = d.ipProfile;
const ipRows = ip
  ? [
      ...(ip.country && pick(ip.country, lang)
        ? [{ label: tr.sim.ipCountry, value: pick(ip.country, lang) }]
        : []),
      { label: tr.sim.ipType, value: `${tr.sim.ipTypes[ip.type]}` },
    ]
  : [];

// Detail-page SERP metadata: a brand-only title and short tagline do not state
// what the page offers. Keep the H1 as the brand, but add the product class to
// <title> and derive a concise, sentence-safe description from the full copy.
const productClass = lang === 'zh'
  ? d.device === 'esim' ? 'eSIM 评测与套餐' : d.device === 'physical' ? 'SIM 卡评测与套餐' : 'SIM/eSIM 评测与套餐'
  : d.device === 'esim' ? 'eSIM Review & Plans' : d.device === 'physical' ? 'SIM Card Review & Plans' : 'SIM & eSIM Review & Plans';
// Query-cluster specific override (GSC-driven CTR pass) wins over the generic template.
const seoTitle = (d.seo?.title && pick(d.seo.title, lang)) || `${name} ${productClass} – ${tr.site.name}`;
const overrideDescription = d.seo?.description ? pick(d.seo.description, lang).replace(/\s+/g, ' ').trim() : '';
const fullDescription = overrideDescription || pick(d.description, lang).replace(/\s+/g, ' ').trim();
const descriptionLimit = lang === 'zh' ? 90 : 155;
const sentenceParts = fullDescription.match(/[^。！？.!?]+[。！？.!?]+/g) ?? [];
let seoDescription = '';
for (const sentence of sentenceParts) {
  if ((seoDescription + sentence).length > descriptionLimit) break;
  seoDescription += sentence;
}
const descriptionMinimum = lang === 'zh' ? 50 : 100;
if (seoDescription.length < descriptionMinimum) seoDescription = '';
if (!seoDescription) {
  const clipped = fullDescription.slice(0, descriptionLimit + 1);
  const boundary = lang === 'zh' ? descriptionLimit : clipped.lastIndexOf(' ');
  seoDescription = `${clipped.slice(0, boundary > descriptionLimit * 0.65 ? boundary : descriptionLimit).trim()}…`;
}
---

<BaseLayout lang={lang} title={seoTitle} description={seoDescription} path={path} ogImage={`/og/sims-${slug}.png`} jsonLd={[productLd, breadcrumbLd]}>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <nav class="label-mono flex items-center gap-1.5 text-ink-500" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')} class="transition-colors hover:text-ink-950">{tr.site.name}</a>
      <span class="text-ink-200">/</span>
      <a href={localePath(lang, '/sims')} class="transition-colors hover:text-ink-950">{tr.sim.breadcrumbList}</a>
      <span class="text-ink-200">/</span>
      <span class="text-ink-600">{name}</span>
    </nav>

    <header class="mt-5 flex flex-wrap items-start justify-between gap-6 border-b border-line pb-7">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-[1.8rem] font-semibold leading-[1.15] tracking-[-0.025em] text-ink-950 sm:text-[2.15rem]">{name}</h1>
          <span class="shrink-0 border border-line px-1.5 py-0.5 font-mono text-[11px] uppercase leading-[1.5] tracking-[0.06em] text-ink-500">{tr.sim.device[d.device]}</span>
        </div>
        <p class="mt-2.5 max-w-[42rem] text-[14.5px] leading-relaxed text-ink-600">{pick(d.tagline, lang)}</p>
        <div class="label-mono mt-3.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-ink-500">
          <span class="font-medium text-ink-900">{d.rating.toFixed(1)}<span class="text-ink-300">/5</span></span>
          <span class="text-ink-200">·</span>
          <span>{coverageLabel}</span>
          <span class="text-ink-200">·</span>
          <span>{tr.sim.updated} {formatDate(d.updatedAt, lang)}</span>
        </div>
      </div>

      <a
        href={d.website}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="group inline-flex h-10 items-center gap-2 bg-ink-950 px-4 text-[13px] font-semibold text-white transition-colors hover:bg-accent"
      >
        {tr.sim.visit}
        <svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5H6.31l7.22 7.22a.75.75 0 1 1-1.06 1.06L5.25 7.31v3.19a.75.75 0 0 1-1.5 0v-4.5z" clip-rule="evenodd"/></svg>
      </a>
    </header>

    <!-- Phones only. Price, validity and the exit-IP nature lived in the sticky
         column, which on a phone stacks below every section — around 3,200px
         down, behind the whole article. This states the three answers people
         open the page for, and the full table keeps its place below. Desktop
         already has that column, so the block is hidden there. -->
    <section class="mt-4 lg:hidden">
      <h2 class="label-mono text-ink-500">{tr.sim.atAGlance}</h2>
      <dl class="mt-2 divide-y divide-line border-y border-line">
        <div class="flex items-baseline justify-between gap-4 py-3">
          <dt class="label-mono shrink-0 text-ink-500">{tr.sim.from}</dt>
          <dd class="font-mono text-[14px] font-medium text-ink-950">{d.plansFrom > 0 ? `$${d.plansFrom.toFixed(2)} USD` : tr.sim.free}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-3">
          <dt class="label-mono shrink-0 text-ink-500">{tr.sim.validity}</dt>
          <dd class="min-w-0 text-right text-[13px] font-medium leading-snug text-ink-950" title={pick(d.validity, lang)}>
            {leadClause(pick(d.validity, lang), 30)}
          </dd>
        </div>
        {ip && (
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="label-mono shrink-0 text-ink-500">{tr.sim.ipExitShort}</dt>
            <dd class="min-w-0 text-right text-[13px] font-medium leading-snug text-ink-950">{tr.sim.ipTypes[ip.type]}</dd>
          </div>
        )}
      </dl>
    </section>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-10">
      <div class="min-w-0 divide-y divide-line">
        {bestFor && (
          <div class="mt-7 mb-1 border-l-2 border-accent py-1 pl-4">
            <p class="text-[14px] leading-relaxed text-ink-700">
              <span class="label-mono mr-1.5 text-ink-500">{tr.sim.bestFor}</span>
              {bestFor}
            </p>
          </div>
        )}

        <section class="py-8 first:pt-7">
          <h2 class="text-[17px] font-semibold text-ink-950">{tr.sim.overview}</h2>
          <div class="prose-sim mt-3">
            <div class="prose-sim-body" set:html={mdDescription} />

            {mdDetails && <div class="prose-sim-body mt-3" set:html={mdDetails} />}
          </div>
        </section>

        {d.plans.length > 0 && (
          <section class="py-8">
            <h2 class="text-[17px] font-semibold text-ink-950">{tr.sim.plans}</h2>
            <!-- Four narrow columns crushed the long "US$4.00 (1 GB/3d) – …"
                 price strings into vertical gibberish on phones. Each plan is
                 one row instead: identity on the left, the price sentence on
                 the right, stacking on narrow screens. -->
            <div class="mt-4">
            <!-- Column labels only mean something in the two-column desktop
                 layout; on phones the row stacks and a right-aligned "PRICE"
                 header would sit above left-aligned prices. -->
            <div class="hidden items-baseline justify-between border-y border-line py-2 sm:flex">
              <span class="label-mono text-ink-500">{tr.sim.planName}</span>
              <span class="label-mono text-ink-500">{tr.sim.planPrice}</span>
            </div>
            <ul class="divide-y divide-line border-t border-line sm:border-t-0">
                {d.plans.map((p) => (
                  <li class="flex flex-col gap-1.5 py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
                    <div class="min-w-0 sm:flex-1">
                      <p class="text-[13.5px] font-medium leading-snug text-ink-950">{pick(p.name, lang)}</p>
                      <p class="mt-1 text-[12px] leading-relaxed text-ink-500">
                        {pick(p.data, lang)}
                        <span class="text-ink-300" aria-hidden="true"> · </span>
                        {pick(p.validity, lang)}
                      </p>
                    </div>
                    <p class="font-mono text-[12px] leading-[1.65] text-ink-700 sm:w-[46%] sm:shrink-0 sm:text-right">
                      {pick(p.price, lang)}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
            {plansNote && <p class="mt-3 text-[12px] leading-relaxed text-ink-500">{plansNote}</p>}
          </section>
        )}

        {(pros?.length || cons?.length) && (
          <section class="py-8">
            <h2 class="text-[17px] font-semibold text-ink-950">{tr.sim.prosCons}</h2>
            <div class="mt-4 grid gap-7 sm:grid-cols-2 sm:gap-8">
              {pros?.length ? (
                <div>
                  <p class="label-mono flex items-center gap-1.5 text-ink-500">
                    <span class="font-mono text-[12px] leading-none text-emerald-700">+</span>
                    {tr.sim.pros}
                  </p>
                  <ul class="mt-2.5 space-y-2">
                    {pros.map((item: string) => (
                      <li class="flex items-start gap-2.5 text-[13.5px] leading-[1.6] text-ink-700">
                        <span class="mt-[7px] h-1 w-1 shrink-0 bg-emerald-700/70" aria-hidden="true"></span>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}
              {cons?.length ? (
                <div class="border-t border-line pt-6 sm:border-t-0 sm:border-l sm:pl-8 sm:pt-0">
                  <p class="label-mono flex items-center gap-1.5 text-ink-500">
                    <span class="font-mono text-[12px] leading-none text-rose-600">−</span>
                    {tr.sim.cons}
                  </p>
                  <ul class="mt-2.5 space-y-2">
                    {cons.map((item: string) => (
                      <li class="flex items-start gap-2.5 text-[13.5px] leading-[1.6] text-ink-700">
                        <span class="mt-[7px] h-1 w-1 shrink-0 bg-rose-500/70" aria-hidden="true"></span>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}
            </div>
          </section>
        )}

        <section class="py-8">
          <h2 class="text-[17px] font-semibold text-ink-950">{tr.sim.features}</h2>
          <ul class="mt-4 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
            {
              features.map((f: string) => (
                <li class="flex items-start gap-2.5 text-[13.5px] leading-[1.6] text-ink-700">
                  <span class="mt-[7px] h-1 w-1 shrink-0 bg-ink-300" aria-hidden="true"></span>
                  {f}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="py-8">
          <h2 class="text-[17px] font-semibold text-ink-950">{tr.sim.related}</h2>
          <!-- grid-cols-1 (not a bare grid): the implicit auto column sizes to
               max-content, and the nowrap provider names then push the whole
               page wider than a phone screen. minmax(0,1fr) clamps it. -->
          <div class="mt-3 grid grid-cols-1 gap-x-8 sm:grid-cols-2">
            {
              related.map((r) => (
                <a
                  href={localePath(lang, `/sims/${r.id}`)}
                  class="group flex min-w-0 items-center justify-between gap-3 border-b border-line py-3 transition-colors hover:border-ink-300"
                >
                  <span class="min-w-0">
                    <span class="block truncate text-[13.5px] font-medium text-ink-900 transition-colors group-hover:text-accent">{pick(r.data.name, lang)}</span>
                    <span class="mt-0.5 block truncate text-[12px] text-ink-500">{pick(r.data.tagline, lang)}</span>
                  </span>
                  <span class="label-mono shrink-0 text-ink-500">
                    {tr.sim.ipTypes[r.data.ipProfile?.type ?? 'unknown']}
                  </span>
                </a>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="mt-4 lg:mt-0 lg:border-l lg:border-line lg:pl-8">
        <div class="lg:sticky lg:top-20 lg:py-7">
          <h2 class="label-mono text-ink-500">{tr.sim.specs}</h2>
          <dl class="mt-3 divide-y divide-line border-y border-line">
            {
              specs.map((s) => (
                <div class="flex items-baseline gap-4 py-2.5">
                  <dt class="w-[5.5rem] shrink-0 text-[12px] text-ink-500">{s.label}</dt>
                  <dd class="min-w-0 flex-1 text-[12.5px] font-medium leading-snug text-ink-950">{s.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-3 text-[12px] leading-[1.7] text-ink-500">{d.regions.map((r) => tr.regions[r]).join(' · ')}</p>

          {
            ip && ipRows.length > 0 && (
              <section class="mt-7 border-t border-line pt-5">
                <h2 class="label-mono text-ink-500">{tr.sim.ipProfile}</h2>
                <dl class="mt-3 divide-y divide-line border-y border-line">
                  {ipRows.map((row) => (
                    <div class="flex items-baseline gap-4 py-2.5">
                      <dt class="w-[5.5rem] shrink-0 text-[12px] text-ink-500">{row.label}</dt>
                      <dd class="min-w-0 flex-1 text-[12.5px] font-medium leading-snug text-ink-950">{row.value}</dd>
                    </div>
                  ))}
                </dl>
                {ip.note && pick(ip.note, lang) && (
                  <p class="mt-3 text-[12px] leading-[1.7] text-ink-500">
                    {pick(ip.note, lang)}{lang === 'zh' ? '（' : ' ('}{tr.sim.ipConfidence[ip.confidence]}{lang === 'zh' ? '）' : ')'}
                  </p>
                )}
              </section>
            )
          }

          <a href={localePath(lang, '/sims')} class="label-mono mt-7 inline-flex items-center gap-1.5 text-ink-500 transition-colors hover:text-ink-950">
            ← {tr.sim.backToList}
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
