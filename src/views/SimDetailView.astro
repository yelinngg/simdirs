---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, pick, formatDate, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getSim } from '../lib/queries';

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const tr = t(lang);
const sim = await getSim(slug);

if (!sim) {
  return Astro.redirect(localePath(lang, '/sims'));
}

const d = sim.data;
const name = pick(d.name, lang);
const description = pick(d.description, lang);
const features = pick(d.features, lang);
const bestFor = d.bestFor ? pick(d.bestFor, lang) : undefined;
const details = d.details ? pick(d.details, lang) : undefined;
const pros = d.pros ? pick(d.pros, lang) : undefined;
const cons = d.cons ? pick(d.cons, lang) : undefined;
const plansNote = d.plansNote ? pick(d.plansNote, lang) : undefined;
const path = `/sims/${slug}`;

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  brand: { '@type': 'Brand', name },
  offers: {
    '@type': 'Offer',
    price: d.plansFrom,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: new URL(localePath(lang, path), Astro.site).href,
  },
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: d.rating,
      bestRating: 5,
      worstRating: 0,
    },
    author: { '@type': 'Organization', name: tr.site.name },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tr.site.name, item: new URL(localePath(lang, '/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: tr.sim.breadcrumbList, item: new URL(localePath(lang, '/sims'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name },
  ],
};

const specs = [
  { label: tr.sim.from, value: `$${d.plansFrom.toFixed(2)} USD` },
  { label: tr.sim.dataFrom, value: d.dataFrom },
  { label: tr.sim.validity, value: d.validity },
  { label: tr.sim.network, value: d.network },
  { label: tr.sim.hotspot, value: d.hotspot ? tr.sim.yes : tr.sim.no },
  { label: tr.sim.coverage, value: `${d.coverage}+ ${tr.sim.countries}` },
];
---

<BaseLayout lang={lang} title={`${name} – ${tr.site.name}`} description={pick(d.tagline, lang)} path={path} ogImage={`/og/sims-${slug}.png`} jsonLd={[productLd, breadcrumbLd]}>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')} class="hover:text-indigo-600">{tr.site.name}</a>
      <span class="mx-1.5">/</span>
      <a href={localePath(lang, '/sims')} class="hover:text-indigo-600">{tr.sim.breadcrumbList}</a>
      <span class="mx-1.5">/</span>
      <span class="font-medium text-slate-900">{name}</span>
    </nav>

    <header class="mt-6 flex flex-wrap items-start justify-between gap-6">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{name}</h1>
          <span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">{tr.sim.device[d.device]}</span>
        </div>
        <p class="mt-2 max-w-2xl text-slate-500">{pick(d.tagline, lang)}</p>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
          <span class="inline-flex items-center gap-1 font-semibold text-amber-500">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.29 3.96a1 1 0 0 0 .95.69h4.16c.97 0 1.37 1.24.59 1.81l-3.37 2.45a1 1 0 0 0-.36 1.12l1.28 3.96c.3.92-.75 1.69-1.54 1.12l-3.36-2.44a1 1 0 0 0-1.18 0l-3.36 2.44c-.78.57-1.84-.2-1.54-1.12l1.29-3.96a1 1 0 0 0-.37-1.12L2.07 9.39c-.78-.57-.38-1.81.59-1.81h4.16a1 1 0 0 0 .95-.69l1.28-3.96z"/></svg>
            {d.rating.toFixed(1)}
          </span>
          <span class="text-slate-300">·</span>
          <span class="text-slate-500">{d.coverage}+ {tr.sim.countries}</span>
          <span class="text-slate-300">·</span>
          <span class="text-slate-500">{tr.sim.updated}: {formatDate(d.updatedAt, lang)}</span>
        </div>
      </div>

      <a
        href={d.website}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700"
      >
        {tr.sim.visit}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5H6.31l7.22 7.22a.75.75 0 1 1-1.06 1.06L5.25 7.31v3.19a.75.75 0 0 1-1.5 0v-4.5z" clip-rule="evenodd"/></svg>
      </a>
    </header>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      <div class="min-w-0 space-y-8 lg:col-span-2">
        {bestFor && (
          <div class="rounded-2xl border border-indigo-200 bg-indigo-50/60 px-6 py-4">
            <p class="text-sm leading-relaxed text-slate-700">
              <span class="font-bold text-indigo-700">{tr.sim.bestFor}:</span> {bestFor}
            </p>
          </div>
        )}

        <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900">{tr.sim.overview}</h2>
          <div class="prose-sim mt-3 leading-relaxed text-slate-700">
            <p class="text-pretty">{description}</p>

            {details && details.split('\n\n').filter((p: string) => p.trim()).map((p: string) => (
              <p class="mt-3 text-pretty">{p}</p>
            ))}
          </div>
        </section>

        {d.plans.length > 0 && (
          <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900">{tr.sim.plans}</h2>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-400">
                    <th class="py-2.5 pr-4 font-semibold">{tr.sim.planName}</th>
                    <th class="py-2.5 pr-4 font-semibold">{tr.sim.dataFrom}</th>
                    <th class="py-2.5 pr-4 font-semibold">{tr.sim.validity}</th>
                    <th class="py-2.5 text-right font-semibold">{tr.sim.planPrice}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {d.plans.map((p: any) => (
                    <tr>
                      <td class="py-3 pr-4 font-medium text-slate-900">{pick(p.name, lang)}</td>
                      <td class="py-3 pr-4 text-slate-600">{pick(p.data, lang)}</td>
                      <td class="py-3 pr-4 text-slate-600">{pick(p.validity, lang)}</td>
                      <td class="py-3 text-right font-semibold text-slate-900">{pick(p.price, lang)}</td>
    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {plansNote && <p class="mt-3 text-xs text-slate-400">{plansNote}</p>}
          </section>
        )}

        {(pros?.length || cons?.length) && (
          <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="grid gap-8 sm:grid-cols-2">
              {pros?.length ? (
                <div>
                  <h2 class="text-xl font-bold text-slate-900">{tr.sim.pros}</h2>
                  <ul class="mt-4 space-y-2.5">
                    {pros.map((item: string) => (
                      <li class="flex items-start gap-2.5 text-sm text-slate-700">
                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm3.85-9.35a.75.75 0 0 0-1.22-.87l-2.97 3.83-1.63-1.62a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.13-.11l3.5-4.5z" clip-rule="evenodd"/></svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}
              {cons?.length ? (
                <div>
                  <h2 class="text-xl font-bold text-slate-900">{tr.sim.cons}</h2>
                  <ul class="mt-4 space-y-2.5">
                    {cons.map((item: string) => (
                      <li class="flex items-start gap-2.5 text-sm text-slate-700">
                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm-1-11a1 1 0 1 1 2 0v4a1 1 0 1 1-2 0V7zm1 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" clip-rule="evenodd"/></svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}
            </div>
          </section>
        )}

        <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900">{tr.sim.features}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              features.map((f: string) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-700">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm3.85-9.35a.75.75 0 0 0-1.22-.87l-2.97 3.83-1.63-1.62a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.13-.11l3.5-4.5z" clip-rule="evenodd"/>
                  </svg>
                  {f}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside>
        <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900">{tr.sim.specs}</h2>
          <dl class="mt-4 divide-y divide-slate-100">
            {
              specs.map((s) => (
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="text-sm text-slate-500">{s.label}</dt>
                  <dd class="text-right text-sm font-semibold text-slate-900">{s.value}</dd>
                </div>
              ))
            }
          </dl>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {d.regions.map((r) => <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600">{tr.regions[r]}</span>)}
          </div>
        </section>

        <a href={localePath(lang, '/sims')} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 hover:text-indigo-700">
          ← {tr.sim.backToList}
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>
