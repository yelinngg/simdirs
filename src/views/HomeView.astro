---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimCard from '../components/SimCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { localePath, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getFeaturedSims, getNews, getAllSims } from '../lib/queries';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);

const FEATURED_COUNT = 9;
const [featured, latestNews, allSims] = await Promise.all([
  getFeaturedSims(FEATURED_COUNT),
  getNews(lang),
  getAllSims(),
]);
const news = latestNews.slice(0, 3);

// Hero eyebrow states the two things a directory can be held to: how many
// providers are covered and when the newest one was last checked.
const lastChecked = allSims.reduce(
  (max, s) => (s.data.updatedAt > max ? s.data.updatedAt : max),
  new Date(0),
);
const checkedLabel = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
}).format(lastChecked);

const stats = [
  { value: allSims.length, label: tr.home.stats.providers },
  { value: new Set(allSims.flatMap((s) => s.data.regions)).size, label: tr.home.stats.regions },
  { value: latestNews.length, label: tr.home.stats.updates },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout lang={lang} title={tr.seo.home.title} description={tr.seo.home.description} path="/">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 pt-12 pb-10 sm:pt-16 sm:pb-14">
      <p class="label-mono flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-500">
        <span class="h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
        <span>{allSims.length}{lang === 'zh' ? ' 家供应商' : ' providers'}</span>
        <span class="text-ink-300" aria-hidden="true">/</span>
        <span>{lang === 'zh' ? '最近核对 ' : 'checked '}{checkedLabel}</span>
      </p>

      <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-14">
        <div class="min-w-0">
          <h1 class="max-w-[44rem] text-[2.05rem] font-semibold leading-[1.1] tracking-[-0.03em] text-ink-950 sm:text-[2.7rem]">
            {tr.hero.title}
          </h1>

          <p class="mt-5 max-w-[38rem] text-[15px] leading-[1.72] text-ink-600 sm:text-[15.5px]">
            {tr.hero.subtitle}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3">
            <a
              href={localePath(lang, '/sims')}
              class="group inline-flex items-center gap-2 bg-ink-950 px-5 py-3 text-[13px] font-semibold text-white transition-colors hover:bg-accent"
            >
              {tr.hero.browse}
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64L9.97 5.97a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l4.42-4.42H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
            </a>
            <a
              href={localePath(lang, '/news')}
              class="text-[13px] font-medium text-ink-600 underline decoration-ink-300 decoration-1 underline-offset-[5px] transition-colors hover:text-ink-950 hover:decoration-ink-900"
            >
              {tr.hero.news}
            </a>
          </div>
        </div>

        <dl class="border-t border-line lg:border-t-0">
          {
            stats.map((s, i) => (
              <div class:list={['flex items-baseline justify-between gap-4 border-b border-line py-3', i === 0 && 'lg:border-t lg:border-line']}>
                <dt class="label-mono text-ink-500">{s.label}</dt>
                <dd class="font-mono text-[19px] font-medium leading-none text-ink-950">{pad(s.value)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12 pb-14 sm:pt-14">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
      <div class="flex items-baseline gap-3">
        <h2 class="text-[18px] font-semibold tracking-[-0.015em] text-ink-950">{tr.home.featured}</h2>
        <span class="label-mono text-ink-500">{pad(featured.length)} / {pad(allSims.length)}</span>
      </div>
      <a
        href={localePath(lang, '/sims')}
        class="group inline-flex items-center gap-1.5 text-[12px] font-medium text-ink-500 transition-colors hover:text-ink-950"
      >
        {tr.home.viewAll}
        <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64L9.97 5.97a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l4.42-4.42H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
      </a>
    </div>

    <p class="mt-4 max-w-[46rem] text-[13px] leading-[1.7] text-ink-500">{tr.home.featuredSub}</p>

    <div class="mt-6 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((sim) => <SimCard sim={sim} lang={lang} />)}
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
        <div class="flex items-baseline gap-3">
          <h2 class="text-[18px] font-semibold tracking-[-0.015em] text-ink-950">{tr.home.latestNews}</h2>
          <span class="label-mono text-ink-500">{pad(latestNews.length)}</span>
        </div>
        <a
          href={localePath(lang, '/news')}
          class="group inline-flex items-center gap-1.5 text-[12px] font-medium text-ink-500 transition-colors hover:text-ink-950"
        >
          {tr.home.viewAll}
          <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64L9.97 5.97a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l4.42-4.42H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
        </a>
      </div>
      <div class="mt-6 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
        {news.map((entry) => <NewsCard entry={entry} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>
