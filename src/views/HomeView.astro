---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimCard from '../components/SimCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { localePath, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getFeaturedSims, getNews, getAllSims } from '../lib/queries';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);

const [featured, latestNews, allSims] = await Promise.all([
  getFeaturedSims(6),
  getNews(lang),
  getAllSims(),
]);
const news = latestNews.slice(0, 3);
const stats = [
  { value: allSims.length, label: tr.home.stats.providers },
  { value: new Set(allSims.flatMap((s) => s.data.regions)).size, label: tr.home.stats.regions },
  { value: latestNews.length, label: tr.home.stats.updates },
];
---

<BaseLayout lang={lang} title={tr.seo.home.title} description={tr.seo.home.description} path="/">
  <section class="bg-gradient-to-br from-indigo-700 via-indigo-600 to-sky-500 text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:py-28">
      <h1 class="mx-auto max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
        {tr.hero.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-indigo-100 sm:text-lg">
        {tr.hero.subtitle}
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localePath(lang, '/sims')}
          class="rounded-xl bg-white px-6 py-3 text-sm font-bold text-indigo-700 shadow-lg transition hover:bg-indigo-50"
        >
          {tr.hero.browse}
        </a>
        <a
          href={localePath(lang, '/news')}
          class="rounded-xl border border-white/40 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10"
        >
          {tr.hero.news}
        </a>
      </div>

      <dl class="mx-auto mt-14 grid max-w-2xl grid-cols-3 gap-4">
        {
          stats.map((s) => (
            <div class="rounded-2xl bg-white/10 px-3 py-4 backdrop-blur">
              <dd class="text-2xl font-extrabold sm:text-3xl">{s.value}</dd>
              <dt class="mt-1 text-xs text-indigo-100 sm:text-sm">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{tr.home.featured}</h2>
        <p class="mt-1 text-sm text-slate-500">{tr.home.featuredSub}</p>
      </div>
      <a href={localePath(lang, '/sims')} class="shrink-0 text-sm font-semibold text-indigo-600 hover:text-indigo-700">
        {tr.home.viewAll} →
      </a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((sim) => <SimCard sim={sim} lang={lang} />)}
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{tr.home.latestNews}</h2>
        <a href={localePath(lang, '/news')} class="shrink-0 text-sm font-semibold text-indigo-600 hover:text-indigo-700">
          {tr.home.viewAll} →
        </a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {news.map((entry) => <NewsCard entry={entry} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>
