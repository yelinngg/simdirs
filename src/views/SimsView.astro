---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimCard from '../components/SimCard.astro';
import { type Locale } from '../i18n/utils';
import { t, REGION_KEYS } from '../i18n/ui';
import { getAllSims } from '../lib/queries';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);
const sims = await getAllSims();

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: tr.sims.title,
  numberOfItems: sims.length,
  itemListElement: sims.slice(0, 20).map((sim, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: sim.data.name[lang] ?? sim.data.name.en,
    url: new URL(`/sims/${sim.id}`, Astro.site).href,
  })),
};
---

<BaseLayout lang={lang} title={tr.seo.sims.title} description={tr.seo.sims.description} path="/sims" jsonLd={[itemListLd]}>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{tr.sims.title}</h1>
    <p class="mt-2 text-slate-500">{tr.sims.subtitle}</p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <div class="relative flex-1">
        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zM2 9a7 7 0 1 1 12.45 4.4l3.07 3.08a.75.75 0 1 1-1.06 1.06l-3.08-3.07A7 7 0 0 1 2 9z" clip-rule="evenodd"/>
        </svg>
        <input
          id="sim-search"
          type="search"
          placeholder={tr.sims.search}
          aria-label={tr.sims.searchLabel}
          class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
        />
      </div>
      <select
        id="region-filter"
        aria-label={tr.sims.regionLabel}
        class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
      >
        <option value="">{tr.sims.allRegions}</option>
        {REGION_KEYS.map((r) => <option value={r}>{tr.regions[r]}</option>)}
      </select>
    </div>

    <p class="mt-5 text-sm text-slate-500" aria-live="polite">
      <span id="sim-count" class="font-bold text-slate-900">{sims.length}</span> {tr.sims.cards}
    </p>

    <div id="sim-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {sims.map((sim) => <SimCard sim={sim} lang={lang} />)}
    </div>

    <p id="sim-empty" class="mt-10 hidden text-center text-sm text-slate-400">{tr.sims.empty}</p>
  </section>

  <script>
    const search = document.getElementById('sim-search') as HTMLInputElement;
    const region = document.getElementById('region-filter') as HTMLSelectElement;
    const count = document.getElementById('sim-count') as HTMLElement;
    const empty = document.getElementById('sim-empty') as HTMLElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-sim-card]'));

    function apply() {
      const q = search.value.trim().toLowerCase();
      const r = region.value;
      let visible = 0;
      for (const card of cards) {
        const matchQuery = !q || (card.dataset.name ?? '').includes(q);
        const matchRegion = !r || (card.dataset.regions ?? '').split(' ').includes(r);
        const show = matchQuery && matchRegion;
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = String(visible);
      empty.classList.toggle('hidden', visible !== 0);
    }

    search.addEventListener('input', apply);
    region.addEventListener('change', apply);
  </script>
</BaseLayout>
