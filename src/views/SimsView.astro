---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimCard from '../components/SimCard.astro';
import { localePath, type Locale } from '../i18n/utils';
import { t, REGION_KEYS } from '../i18n/ui';
import { getAllSims } from '../lib/queries';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);
const sims = await getAllSims();

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: tr.sims.title,
  numberOfItems: sims.length,
  itemListElement: sims.slice(0, 20).map((sim, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: sim.data.name[lang] ?? sim.data.name.en,
    url: new URL(localePath(lang, `/sims/${sim.id}`), Astro.site).href,
  })),
};
---

<BaseLayout lang={lang} title={tr.seo.sims.title} description={tr.seo.sims.description} path="/sims" jsonLd={[itemListLd]}>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
      <p class="label-mono flex items-center gap-2 text-[10px] text-ink-500">
        <span class="h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
        {String(sims.length).padStart(2, '0')}{lang === 'zh' ? ' 家收录' : ' listed'}
      </p>
      <h1 class="mt-4 text-[1.8rem] font-semibold tracking-[-0.025em] text-ink-950 sm:text-[2.2rem]">{tr.sims.title}</h1>
      <p class="mt-2.5 max-w-[42rem] text-[14px] leading-relaxed text-ink-600">{tr.sims.subtitle}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-2 sm:flex-row">
      <div class="relative flex-1">
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zM2 9a7 7 0 1 1 12.45 4.4l3.07 3.08a.75.75 0 1 1-1.06 1.06l-3.08-3.07A7 7 0 0 1 2 9z" clip-rule="evenodd"/>
        </svg>
        <input
          id="sim-search"
          type="search"
          placeholder={tr.sims.search}
          aria-label={tr.sims.searchLabel}
          class="h-10 w-full rounded border border-line bg-paper pl-9 pr-3 text-[13px] text-ink-900 transition-colors outline-none placeholder:text-ink-500 focus:border-accent focus:ring-2 focus:ring-accent/15"
        />
      </div>
      <select
        id="region-filter"
        aria-label={tr.sims.regionLabel}
        class="h-10 rounded border border-line bg-paper px-3 text-[13px] text-ink-900 transition-colors outline-none focus:border-accent focus:ring-2 focus:ring-accent/15 sm:w-52"
      >
        <option value="">{tr.sims.allRegions}</option>
        {REGION_KEYS.map((r) => <option value={r}>{tr.regions[r]}</option>)}
      </select>
    </div>

    <p class="label-mono mt-5 text-[10px] text-ink-500" aria-live="polite">
      <span id="sim-count" class="font-medium text-ink-950">{sims.length}</span> {tr.sims.cards}
    </p>

    <div id="sim-grid" class="mt-4 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
      {sims.map((sim) => <SimCard sim={sim} lang={lang} />)}
    </div>

    <p id="sim-empty" class="mt-10 hidden text-center text-[13px] text-ink-500">{tr.sims.empty}</p>
  </section>

  <script>
    const search = document.getElementById('sim-search') as HTMLInputElement;
    const region = document.getElementById('region-filter') as HTMLSelectElement;
    const count = document.getElementById('sim-count') as HTMLElement;
    const empty = document.getElementById('sim-empty') as HTMLElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-sim-card]'));

    function apply() {
      const q = search.value.trim().toLowerCase();
      const r = region.value;
      let visible = 0;
      for (const card of cards) {
        const matchQuery = !q || (card.dataset.name ?? '').includes(q);
        const matchRegion = !r || (card.dataset.regions ?? '').split(' ').includes(r);
        const show = matchQuery && matchRegion;
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = String(visible);
      empty.classList.toggle('hidden', visible !== 0);
    }

    search.addEventListener('input', apply);
    region.addEventListener('change', apply);
  </script>
</BaseLayout>
