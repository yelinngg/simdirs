---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, formatDate, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getNewsEntry } from '../lib/queries';
import { readingTime } from '../lib/format';

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const tr = t(lang);
const entry = await getNewsEntry(lang, slug);

// Slugs come from getStaticPaths; a miss means the pair is out of sync.
if (!entry) throw new Error(`No ${lang} news entry for slug "${slug}"`);

const { Content } = await render(entry);
const path = `/news/${slug}`;

// Same estimate the listing shows, so a card's promise matches the article.
const minutes = readingTime(entry.body);
const readTime = minutes ? tr.news.readTime.replace('{n}', String(minutes)) : '';

// Pair with the same post in the other language for hreflang links
const otherLang = lang === 'en' ? 'zh' : 'en';
const translation = await getNewsEntry(otherLang, slug);
const alternates = translation
  ? { [otherLang]: path }
  : { [otherLang]: null };

const articleUrl = new URL(localePath(lang, path), Astro.site).href;
const articleImage = new URL(`/og/news-${slug}.png`, Astro.site).href;
const publisher = {
  '@type': 'Organization',
  name: tr.site.name,
  url: new URL(localePath(lang, '/'), Astro.site).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.svg', Astro.site).href,
  },
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  inLanguage: lang,
  url: articleUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  image: {
    '@type': 'ImageObject',
    url: articleImage,
    width: 1200,
    height: 630,
  },
  author: publisher,
  publisher,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tr.site.name, item: new URL(localePath(lang, '/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: tr.news.title, item: new URL(localePath(lang, '/news'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title },
  ],
};
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} – ${tr.site.name}`}
  description={entry.data.description}
  path={path}
  alternates={alternates}
  type="article"
  publishedTime={entry.data.date}
  ogImage={`/og/news-${slug}.png`}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="mx-auto max-w-[46rem] px-4 py-8 sm:py-10">
    <nav class="label-mono flex items-center gap-1.5 text-ink-500" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')} class="transition-colors hover:text-ink-950">{tr.site.name}</a>
      <span class="text-ink-200">/</span>
      <a href={localePath(lang, '/news')} class="transition-colors hover:text-ink-950">{tr.news.title}</a>
    </nav>

    <header class="mt-5 border-b border-line pb-7">
      <div class="label-mono flex flex-wrap items-center gap-x-2.5 text-ink-500">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
        {entry.data.tags.slice(0, 2).map((tag) => (
          <>
            <span class="text-ink-200" aria-hidden="true">/</span>
            <span>#{tag}</span>
          </>
        ))}
        {readTime && (
          <>
            <span class="text-ink-200" aria-hidden="true">/</span>
            <span>{readTime}</span>
          </>
        )}
      </div>
      <h1 class="mt-3 text-[1.75rem] font-semibold leading-[1.2] tracking-[-0.025em] text-ink-950 sm:text-[2.1rem]">
        {entry.data.title}
      </h1>
      <p class="mt-4 text-[15px] leading-[1.7] text-ink-600">{entry.data.description}</p>
    </header>

    <div class="news-article mt-8">
      <Content />
    </div>

    <footer class="mt-12 border-t border-line pt-5">
      <a href={localePath(lang, '/news')} class="label-mono inline-flex items-center gap-1.5 text-ink-500 transition-colors hover:text-ink-950">
        ← {tr.news.back}
      </a>
    </footer>
  </article>
</BaseLayout>
