---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, formatDate, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getNewsEntry } from '../lib/queries';

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const tr = t(lang);
const entry = await getNewsEntry(lang, slug);

if (!entry) {
  return Astro.redirect(localePath(lang, '/news'));
}

const { Content } = await render(entry);
const path = `/news/${slug}`;

// Pair with the same post in the other language for hreflang links
const otherLang = lang === 'en' ? 'zh' : 'en';
const translation = await getNewsEntry(otherLang, slug);
const alternates = translation
  ? { [otherLang]: path }
  : { [otherLang]: null };

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  inLanguage: lang,
  mainEntityOfPage: new URL(localePath(lang, path), Astro.site).href,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tr.site.name, item: new URL(localePath(lang, '/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: tr.news.title, item: new URL(localePath(lang, '/news'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title },
  ],
};
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} – ${tr.site.name}`}
  description={entry.data.description}
  path={path}
  alternates={alternates}
  type="article"
  publishedTime={entry.data.date}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')} class="hover:text-indigo-600">{tr.site.name}</a>
      <span class="mx-1.5">/</span>
      <a href={localePath(lang, '/news')} class="hover:text-indigo-600">{tr.news.title}</a>
    </nav>

    <header class="mt-6 border-b border-slate-200 pb-8">
      <div class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
        <time datetime={entry.data.date.toISOString()}>{tr.news.published}: {formatDate(entry.data.date, lang)}</time>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-500">{entry.data.description}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          entry.data.tags.map((tag) => (
            <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-600">#{tag}</span>
          ))
        }
      </div>
    </header>

    <div class="news-article mt-8">
      <Content />
    </div>

    <footer class="mt-12 border-t border-slate-200 pt-6">
      <a href={localePath(lang, '/news')} class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 hover:text-indigo-700">
        ← {tr.news.back}
      </a>
    </footer>
  </article>
</BaseLayout>
