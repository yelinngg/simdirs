---
import { localePath, pick, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import { leadClause } from '../lib/format';
import type { SimEntry } from '../lib/queries';

interface Props {
  sim: SimEntry;
  lang: Locale;
}

const { sim, lang } = Astro.props;
const tr = t(lang);
const other: Locale = lang === 'en' ? 'zh' : 'en';
const trOther = t(other);
const d = sim.data;
const name = pick(d.name, lang);
const tagline = pick(d.tagline, lang);
const href = localePath(lang, `/sims/${sim.id}`);
const regionLabels = d.regions.slice(0, 3).map((r) => tr.regions[r]);
const dataFrom = pick(d.dataFrom, lang);
const validity = pick(d.validity, lang);

// The directory search has to answer "which card works in Japan" as well as
// "Airalo", so the haystack carries both languages: name, tagline, every region
// label, network and device type. Searching the visible text alone would miss
// the regions, which are the reason most people open this page.
const searchText = [
  name,
  pick(d.name, other),
  sim.id,
  tagline,
  pick(d.tagline, other),
  ...d.regions.map((r) => `${r} ${tr.regions[r]} ${trOther.regions[r]}`),
  pick(d.network, lang),
  pick(d.network, other),
  tr.sim.device[d.device],
  trOther.sim.device[d.device],
]
  .join(' ')
  .toLowerCase();
---

<!-- The whole card is the hit area. The title link carries a stretched ::after
     that covers the padding box, so a click anywhere lands on the same URL and
     the card stays one link for screen readers instead of three overlapping
     ones. -->
<article
  data-sim-card
  data-search={searchText}
  data-regions={d.regions.join(' ')}
  class="group relative flex min-w-0 flex-col border-r border-b border-line bg-paper p-5 transition-colors hover:bg-ink-50 focus-within:bg-ink-50 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:-outline-offset-2 has-[a:focus-visible]:outline-accent"
>
  <div class="flex items-start justify-between gap-3">
    <!-- Reserved height: two title lines plus two tagline lines. Without it a
         one-line name or tagline lifts this card's spec block above its
         neighbours', and the row of bordered blocks stops reading as a row. -->
    <div class="min-h-[86px] min-w-0">
      <h3 class="line-clamp-2 text-[16px] font-semibold leading-[1.35] tracking-[-0.01em] text-ink-950">
        <a href={href} class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-accent">{name}</a>
      </h3>
      <p class="mt-1 line-clamp-2 text-[13px] leading-[1.6] text-ink-500">{tagline}</p>
    </div>
    <span class="mt-0.5 shrink-0 border border-line px-1.5 py-0.5 font-mono text-[9.5px] uppercase leading-[1.5] tracking-[0.06em] text-ink-500">
      {tr.sim.device[d.device]}
    </span>
  </div>

  <div class="mt-3 flex items-baseline gap-2.5 text-[11px] leading-none">
    <span class="font-mono font-medium text-ink-900">{d.rating.toFixed(1)}<span class="text-ink-300">/5</span></span>
    <span class="h-3 w-px bg-line" aria-hidden="true"></span>
    <span class="truncate text-[12px] text-ink-500">{pick(d.network, lang)}</span>
  </div>

  <dl class="mt-4 divide-y divide-line border-y border-line">
    <div class="flex items-baseline justify-between gap-3 py-2">
      <dt class="label-mono shrink-0 text-[10px] text-ink-500">{tr.sim.from}</dt>
      <dd class="font-mono text-[12.5px] font-medium text-ink-950">{d.plansFrom > 0 ? `$${d.plansFrom.toFixed(2)}` : tr.sim.free}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-3 py-2">
      <dt class="label-mono shrink-0 text-[10px] text-ink-500">{tr.sim.dataFrom}</dt>
      <dd class="line-clamp-2 text-right text-[12.5px] font-medium leading-snug text-ink-800" title={dataFrom}>
        {leadClause(dataFrom)}
      </dd>
    </div>
    <div class="flex items-baseline justify-between gap-3 py-2">
      <dt class="label-mono shrink-0 text-[10px] text-ink-500">{tr.sim.validity}</dt>
      <dd class="line-clamp-2 text-right text-[12.5px] font-medium leading-snug text-ink-800" title={validity}>
        {leadClause(validity)}
      </dd>
    </div>
  </dl>

  <p class="mt-3 truncate text-[11.5px] text-ink-500">
    {regionLabels.join(' · ')}{d.regions.length > 3 ? ` +${d.regions.length - 3}` : ''}
  </p>

  <!-- Affordance only: the stretched title link above already owns the click,
       so a second anchor here would just be a duplicate tab stop. -->
  <div class="mt-auto flex items-center justify-between gap-2 border-t border-line pt-3 text-[12px] font-medium text-ink-500 transition-colors group-hover:text-ink-950">
    <span>{tr.sim.viewDetails}</span>
    <svg class="h-3.5 w-3.5 text-ink-400 transition-all group-hover:translate-x-0.5 group-hover:text-ink-950" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64L9.97 5.97a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l4.42-4.42H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
  </div>
</article>
