---
import { localePath, formatDate, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { NewsEntry } from '../lib/queries';
import { newsSlug } from '../lib/queries';

interface Props {
  entry: NewsEntry;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const tr = t(lang);
const href = localePath(lang, `/news/${newsSlug(entry)}`);
---

<article class="group relative flex flex-col border-r border-b border-line bg-paper p-6 transition-colors hover:bg-ink-50 focus-within:bg-ink-50">
  <div class="label-mono flex items-center gap-2.5 text-[10px] text-ink-500">
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
    {entry.data.tags.slice(0, 1).map((tag) => (
      <>
        <span class="h-2.5 w-px bg-line" aria-hidden="true"></span>
        <span class="truncate normal-case tracking-normal">#{tag}</span>
      </>
    ))}
  </div>

  <h3 class="mt-3 line-clamp-3 text-[16px] font-semibold leading-[1.4] tracking-[-0.01em] text-ink-950">
    <a href={href} class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-accent">{entry.data.title}</a>
  </h3>

  <p class="mt-2 mb-6 line-clamp-3 text-[13px] leading-[1.65] text-ink-500">{entry.data.description}</p>

  <!-- Same stretched-link pattern as SimCard: one link per card, the whole
       card clickable, and this row is only the affordance. -->
  <div class="mt-auto flex items-center justify-between gap-2 border-t border-line pt-3 text-[12px] font-medium text-ink-500 transition-colors group-hover:text-ink-950">
    <span>{tr.news.readMore}</span>
    <svg class="h-3.5 w-3.5 text-ink-400 transition-all group-hover:translate-x-0.5 group-hover:text-ink-950" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64L9.97 5.97a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l4.42-4.42H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
  </div>
</article>
