---
import { localePath, formatDate, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { NewsEntry } from '../lib/queries';
import { newsSlug } from '../lib/queries';

interface Props {
  entry: NewsEntry;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const tr = t(lang);
const href = localePath(lang, `/news/${newsSlug(entry)}`);
---

<article class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md">
  <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
    {entry.data.tags.slice(0, 3).map((tag) => (
      <span class="rounded-full bg-indigo-50 px-2 py-0.5 font-medium text-indigo-600">#{tag}</span>
    ))}
  </div>

  <h3 class="mt-2 text-lg font-bold leading-snug text-slate-900">
    <a href={href} class="transition hover:text-indigo-600">{entry.data.title}</a>
  </h3>

  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-500">{entry.data.description}</p>

  <a href={href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 transition hover:gap-2 hover:text-indigo-700">
    {tr.news.readMore}
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64L9.97 5.97a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l4.42-4.42H3.75A.75.75 0 0 1 3 10z" clip-rule="evenodd"/></svg>
  </a>
</article>
