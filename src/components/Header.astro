---
import { localePath, locales, translatePath, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const tr = t(lang);
const langLabel: Record<Locale, string> = { en: 'EN', zh: '中文' };

// Section state comes from the path so the header can say where you are
// instead of leaving every link identical.
const stripLocale = currentPath.replace(/^\/zh(?=\/|$)/, '') || '/';
const isActive = (href: string) => stripLocale === href || stripLocale.startsWith(`${href}/`);
const linkClass = (href: string) => {
  const active = isActive(href);
  return [
    'relative py-1 transition-colors after:absolute after:-bottom-0.5 after:left-0 after:h-px after:bg-ink-900 after:transition-[width] after:duration-200',
    active
      ? 'text-ink-950 after:w-full'
      : 'text-ink-500 after:w-0 hover:text-ink-950 hover:after:w-full',
  ].join(' ');
};
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-4 sm:h-16">
    <a href={localePath(lang, '/')} class="flex min-w-0 shrink-0 items-center gap-2.5">
      <svg viewBox="0 0 64 64" class="h-7 w-7 shrink-0 sm:h-[30px] sm:w-[30px]" aria-hidden="true">
        <rect x="6" y="2" width="52" height="60" rx="9" fill="#111820" />
        <path d="M22 14h10a16 16 0 0 1 16 16v14a8 8 0 0 1-8 8H22a8 8 0 0 1-8-8V22a8 8 0 0 1 8-8z" fill="#ffffff" />
        <rect x="20" y="20" width="11" height="9" rx="1.5" fill="#111820" />
        <rect x="33" y="20" width="11" height="9" rx="1.5" fill="#0f4c81" />
        <rect x="20" y="31" width="11" height="9" rx="1.5" fill="#111820" />
        <rect x="33" y="31" width="11" height="9" rx="1.5" fill="#111820" />
      </svg>
      <span class="flex flex-col justify-center leading-none">
        <span class="text-[15px] font-semibold tracking-[-0.01em] text-ink-950 sm:text-base">SimDirs</span>
        <span class="label-mono mt-1 hidden text-[10px] leading-none text-ink-500 sm:block">{tr.site.kicker}</span>
      </span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <nav class="flex items-center gap-3 text-[13px] font-medium sm:gap-5" aria-label="Main">
        <a href={localePath(lang, '/sims')} class={linkClass('/sims')} aria-current={isActive('/sims') ? 'page' : undefined}>{tr.nav.sims}</a>
        <a href={localePath(lang, '/news')} class={linkClass('/news')} aria-current={isActive('/news') ? 'page' : undefined}>{tr.nav.news}</a>
      </nav>

      <span class="h-4 w-px bg-line" aria-hidden="true"></span>

      <div class="flex shrink-0 items-center gap-2" role="group" aria-label="Language">
        {
          locales.map((l, i) => (
            <>
              {i > 0 && <span class="label-mono text-ink-300">/</span>}
              <a
                href={translatePath(currentPath, l)}
                hreflang={l}
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'label-mono whitespace-nowrap transition-colors',
                  l === lang ? 'text-ink-950' : 'text-ink-500 hover:text-ink-700',
                ]}
              >
                {langLabel[l]}
              </a>
            </>
          ))
        }
      </div>
    </div>
  </div>
</header>
