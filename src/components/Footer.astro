---
import { localePath, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-3">
    <div>
      <p class="flex items-center gap-2 text-lg font-extrabold text-slate-900">Sim<span class="text-indigo-600">Dirs</span></p>
      <p class="mt-3 text-sm leading-relaxed text-slate-500">{tr.footer.about}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-slate-900">{tr.footer.quickLinks}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-500">
        <li><a href={localePath(lang, '/sims')} class="hover:text-indigo-600">{tr.nav.sims}</a></li>
        <li><a href={localePath(lang, '/news')} class="hover:text-indigo-600">{tr.nav.news}</a></li>
        <li><a href="/" class="hover:text-indigo-600">SimDirs</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-slate-900">{tr.footer.feeds}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-500">
        <li>
          <a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:text-indigo-600">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 20.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM2 10.36v3.06c4.72 0 8.55 3.83 8.55 8.55h3.06c0-6.42-5.2-11.61-11.61-11.61zM2 4v3.06c8.1 0 14.7 6.6 14.7 14.7h3.06C19.76 11.97 11.79 4 2 4z"/></svg>
            RSS (English)
          </a>
        </li>
        <li>
          <a href="/zh/rss.xml" class="inline-flex items-center gap-1.5 hover:text-indigo-600">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 20.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM2 10.36v3.06c4.72 0 8.55 3.83 8.55 8.55h3.06c0-6.42-5.2-11.61-11.61-11.61zM2 4v3.06c8.1 0 14.7 6.6 14.7 14.7h3.06C19.76 11.97 11.79 4 2 4z"/></svg>
            RSS（中文）
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-100 py-5 text-center text-xs text-slate-400">
    © {year} SimDirs · {tr.footer.rights}
  </div>
</footer>
