---
import { localePath, type Locale } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
const link = 'transition-colors hover:text-ink-950';
---

<footer class="border-t border-line bg-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-[1.6fr_1fr_1fr] sm:gap-8">
    <div>
      <p class="flex items-center gap-2 text-[15px] font-semibold tracking-[-0.01em] text-ink-950">
        <svg viewBox="0 0 64 64" class="h-5 w-5" aria-hidden="true">
          <rect x="6" y="2" width="52" height="60" rx="9" fill="#111820" />
          <path d="M22 14h10a16 16 0 0 1 16 16v14a8 8 0 0 1-8 8H22a8 8 0 0 1-8-8V22a8 8 0 0 1 8-8z" fill="#ffffff" />
          <rect x="20" y="20" width="11" height="9" rx="1.5" fill="#111820" />
          <rect x="33" y="20" width="11" height="9" rx="1.5" fill="#0f4c81" />
          <rect x="20" y="31" width="11" height="9" rx="1.5" fill="#111820" />
          <rect x="33" y="31" width="11" height="9" rx="1.5" fill="#111820" />
        </svg>
        {tr.site.name}
      </p>
      <p class="mt-3 max-w-xs text-[13px] leading-relaxed text-ink-500">{tr.footer.about}</p>
      <p class="label-mono mt-4 text-[10px] text-ink-300">{tr.footer.note}</p>
    </div>

    <div>
      <p class="label-mono text-[10px] text-ink-500">{tr.footer.quickLinks}</p>
      <ul class="mt-3 space-y-2 text-[13px] text-ink-600">
        <li><a href={localePath(lang, '/sims')} class={link}>{tr.nav.sims}</a></li>
        <li><a href={localePath(lang, '/news')} class={link}>{tr.nav.news}</a></li>
        <li><a href={localePath(lang, '/')} class={link}>SimDirs</a></li>
      </ul>
    </div>

    <div>
      <p class="label-mono text-[10px] text-ink-500">{tr.footer.feeds}</p>
      <ul class="mt-3 space-y-2 text-[13px] text-ink-600">
        <li>
          <a href="/rss.xml" class="inline-flex items-center gap-2 {link}">
            <svg class="h-3.5 w-3.5 text-ink-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 20.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM2 10.36v3.06c4.72 0 8.55 3.83 8.55 8.55h3.06c0-6.42-5.2-11.61-11.61-11.61zM2 4v3.06c8.1 0 14.7 6.6 14.7 14.7h3.06C19.76 11.97 11.79 4 2 4z"/></svg>
            RSS (English)
          </a>
        </li>
        <li>
          <a href="/zh/rss.xml" class="inline-flex items-center gap-2 {link}">
            <svg class="h-3.5 w-3.5 text-ink-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 20.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM2 10.36v3.06c4.72 0 8.55 3.83 8.55 8.55h3.06c0-6.42-5.2-11.61-11.61-11.61zM2 4v3.06c8.1 0 14.7 6.6 14.7 14.7h3.06C19.76 11.97 11.79 4 2 4z"/></svg>
            RSS（中文）
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-4 text-[11px] text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} SimDirs · {tr.footer.rights}</p>
      <p class="label-mono text-[10px] text-ink-300">simdirs.com</p>
    </div>
  </div>
</footer>
